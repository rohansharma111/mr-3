generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String       @id @default(uuid()) @db.Uuid
  name       String
  email      String       @unique
  passwordHash String?    @map("password_hash")
  role       String       @default("FIELD_MANAGER")
  isActive   Boolean      @default(true) @map("is_active")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  calls      Call[]
  samples    SampleIssue[]
  targets    Target[]
  plans      Plan[]
  auditLogs  AuditLog[]
  notifications Notification[]
  @@map("app_users")
}

model Patch {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @unique
  state       String        @default("Maharashtra")
  region      String        @default("Andheri Region")
  doctorCount Int           @default(0) @map("doctor_count")
  isDemo      Boolean       @default(true) @map("is_demo")
  doctors     DoctorPatch[]
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@index([state, region])
  @@map("patches")
}

model Specialty {
  id      String   @id @default(uuid()) @db.Uuid
  name    String   @unique
  doctors Doctor[]
  @@map("specialties")
}

model Doctor {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  specialtyId  String?       @map("specialty_id") @db.Uuid
  specialty    Specialty?    @relation(fields: [specialtyId], references: [id])
  clinic       String
  location     String
  score        Int           @default(0)
  potential    String        @default("MEDIUM")
  distanceKm   Decimal?      @map("distance_km") @db.Decimal
  latitude     Decimal?      @db.Decimal
  longitude    Decimal?      @db.Decimal
  mapX         Decimal?      @map("map_x") @db.Decimal(5, 2)
  mapY         Decimal?      @map("map_y") @db.Decimal(5, 2)
  isActive     Boolean       @default(true) @map("is_active")
  isDemo       Boolean       @default(true) @map("is_demo")
  patches      DoctorPatch[]
  calls        Call[]
  samples      SampleIssue[]
  plans        Plan[]
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@index([specialtyId])
  @@index([potential, score])
  @@map("doctors")
}

model DoctorPatch {
  doctorId String @map("doctor_id") @db.Uuid
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patchId  String @map("patch_id") @db.Uuid
  patch    Patch  @relation(fields: [patchId], references: [id], onDelete: Cascade)
  @@id([doctorId, patchId])
  @@map("doctor_patches")
}

model Product {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @unique
  molecule  String?
  category  String?
  isActive  Boolean       @default(true) @map("is_active")
  isDemo    Boolean       @default(true) @map("is_demo")
  calls     Call[]
  samples   SampleIssue[]
  inventory StockistInventory[]
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("products")
}

model Call {
  id        String    @id @default(uuid()) @db.Uuid
  doctorId  String    @map("doctor_id") @db.Uuid
  doctor    Doctor    @relation(fields: [doctorId], references: [id])
  userId    String?   @map("user_id") @db.Uuid
  user      User?     @relation(fields: [userId], references: [id])
  productId String?   @map("product_id") @db.Uuid
  product   Product?  @relation(fields: [productId], references: [id])
  status    String    @default("COMPLETED")
  outcome   String?
  notes     String?
  calledAt  DateTime  @default(now()) @map("called_at") @db.Timestamptz(6)
  isDemo    Boolean   @default(true) @map("is_demo")
  @@index([doctorId, calledAt])
  @@index([userId, calledAt])
  @@map("calls")
}

model Plan {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctorId  String   @map("doctor_id") @db.Uuid
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  plannedFor DateTime @map("planned_for") @db.Timestamptz(6)
  priority  String   @default("NORMAL")
  objective String   @default("")
  status    String   @default("PLANNED")
  notes     String   @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@unique([userId, doctorId, plannedFor])
  @@index([userId, plannedFor])
  @@index([doctorId, plannedFor])
  @@index([status, plannedFor])
  @@map("plans")
}

model SampleIssue {
  id        String   @id @default(uuid()) @db.Uuid
  doctorId  String   @map("doctor_id") @db.Uuid
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
  productId String?  @map("product_id") @db.Uuid
  product   Product? @relation(fields: [productId], references: [id])
  userId    String?  @map("user_id") @db.Uuid
  user      User?    @relation(fields: [userId], references: [id])
  quantity  Int
  status    String   @default("ISSUED")
  issuedAt  DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  isDemo    Boolean  @default(true) @map("is_demo")
  @@map("sample_issues")
}

model WritingPatternSnapshot {
  id          String   @id @default(uuid()) @db.Uuid
  period      String   @unique
  categories  Json     @db.JsonB
  molecules   Json     @db.JsonB
  insight     String
  sourceLabel String   @default("PROTOTYPE_SOURCE") @map("source_label")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@map("writing_pattern_snapshots")
}

model Stockist {
  id        String             @id @default(uuid()) @db.Uuid
  name      String             @unique
  location  String
  isActive  Boolean            @default(true) @map("is_active")
  isDemo    Boolean            @default(true) @map("is_demo")
  inventory StockistInventory[]
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("stockists")
}

model StockistInventory {
  id        String   @id @default(uuid()) @db.Uuid
  stockistId String  @map("stockist_id") @db.Uuid
  stockist   Stockist @relation(fields: [stockistId], references: [id], onDelete: Cascade)
  productId  String   @map("product_id") @db.Uuid
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int      @default(0)
  unit       String   @default("strips")
  status     String   @default("GOOD")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@unique([stockistId, productId])
  @@map("stockist_inventory")
}

model Target {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String?  @map("user_id") @db.Uuid
  user             User?    @relation(fields: [userId], references: [id])
  periodStart      DateTime @map("period_start") @db.Date
  periodEnd        DateTime @map("period_end") @db.Date
  targetCalls      Int      @default(0) @map("target_calls")
  targetSamples    Int      @default(0) @map("target_samples")
  targetConversions Int     @default(0) @map("target_conversions")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([userId, periodStart, periodEnd])
  @@index([userId, periodStart, periodEnd])
  @@map("targets")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json     @default("{}") @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}


model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("INFO")
  title     String
  message   String
  actionUrl String?  @map("action_url")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model RateLimitBucket {
  key         String   @id
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  requestCount Int     @default(0) @map("request_count")
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}
